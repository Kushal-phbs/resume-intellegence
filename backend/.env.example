# Application metadata
# Application name used in logs and health reports
APP_NAME=AI Resume Intelligence Platform
# Application version exposed by the health endpoint
APP_VERSION=0.1.0
# Runtime environment: development, staging, production
ENVIRONMENT=development
# Debug mode controls extra logging and local diagnostics
DEBUG=true

# LLM provider configuration
# Select the active language model provider
LLM_PROVIDER=groq

# Groq provider credentials
# Placeholder only: do not commit real API keys
GROQ_API_KEY=
# Model identifier used by the Groq API
GROQ_MODEL=llama-3.3-70b-versatile

# Database configuration
# Async SQLAlchemy connection string (must use the postgresql+asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_intelligence
# Echo SQL statements to logs (development only)
DB_ECHO=false
# Connection pool sizing
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# Security / JWT configuration
# Secret key used to sign tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Placeholder only: do not commit real secrets. Must be at least 32 characters.
SECRET_KEY=
# Signing algorithm for JWTs (e.g. HS256, HS384, HS512, RS256)
JWT_ALGORITHM=HS256
# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=
JWT_AUDIENCE=

# Redis/cache configuration
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_DASHBOARD_SUMMARY_TTL_SECONDS=120
CACHE_DASHBOARD_STATISTICS_TTL_SECONDS=120
CACHE_DASHBOARD_TRENDS_TTL_SECONDS=180
CACHE_DASHBOARD_PERFORMANCE_TTL_SECONDS=120
CACHE_RESUME_ANALYSIS_TTL_SECONDS=300
CACHE_JOB_ANALYSIS_TTL_SECONDS=300

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_RESUME_UPLOAD_REQUESTS=20
RATE_LIMIT_RESUME_ANALYSIS_REQUESTS=20
RATE_LIMIT_JOB_ANALYSIS_REQUESTS=20
RATE_LIMIT_RESUME_TAILORING_REQUESTS=20
RATE_LIMIT_EXPORT_REQUESTS=40
RATE_LIMIT_DASHBOARD_REFRESH_REQUESTS=10

# CORS and host hardening
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Resume storage configuration
# Directory (relative or absolute) where uploaded resume files are stored
RESUME_UPLOAD_DIR=uploads/resumes
# Maximum allowed resume upload size, in megabytes
RESUME_MAX_UPLOAD_SIZE_MB=5
# Comma-separated list of allowed resume file extensions
RESUME_ALLOWED_EXTENSIONS=pdf,doc,docx
# Comma-separated list of allowed resume MIME types
RESUME_ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Sentry error monitoring (optional — leave empty to disable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENVIRONMENT=
